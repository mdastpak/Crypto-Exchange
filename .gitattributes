# Auto detect text files and perform LF normalization
* text=auto

# Go sources and module files keep LF line endings on every platform, so that
# gofmt -l and go mod tidy -diff give the same result on Windows as in CI.
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf

# Files read by Linux containers keep LF line endings on every platform, so
# that line continuations in Dockerfile commands work after a Windows checkout.
Dockerfile text eol=lf
.dockerignore text eol=lf
*.sh text eol=lf
# Docker Compose reads .env, copied from .env.example; a CR would end up in
# the values.
.env.example text eol=lf

# The OpenAPI document that swag generates keeps LF line endings, as swag
# writes them, so that the CI check that regenerates it finds no difference
# after a Windows checkout either.
docs/swagger.json text eol=lf
docs/swagger.yaml text eol=lf

# The OpenAPI document is generated (#54): GitHub collapses its diffs, and
# scripts/sync-main.sh generates it again after a merge instead of resolving
# its conflicts by hand (#476).
docs/docs.go linguist-generated=true
docs/swagger.json linguist-generated=true
docs/swagger.yaml linguist-generated=true
