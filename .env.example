# Crypto Exchange environment variables
#
# Copy this file to .env. Docker Compose reads it for the variables in
# docker-compose.yml and passes all of it to the app service, so
# "docker compose up" works with these values as they are. Outside Compose,
# export the variables yourself, for example with "set -a; . ./.env; set +a".
#
# Every variable overrides one setting of the configuration file. An empty
# variable leaves the setting unchanged. docs/configuration.md lists all of
# them. The values below are the local defaults.

# The region of this release: ir (the default) or international, which
# refuses the features of Iran.
DEPLOYMENT_REGION=ir

# Server
SERVER_IP=0.0.0.0
SERVER_PORT=8080
# debug, release, or test. Release mode refuses insecure settings, such as
# no TLS or default passwords; docs/configuration.md lists them.
SERVER_MODE=debug
SERVER_READ_TIMEOUT_SECONDS=10
SERVER_WRITE_TIMEOUT_SECONDS=10
SERVER_IDLE_TIMEOUT_SECONDS=120

# PostgreSQL. The host names are the Compose service names; use localhost
# when the server runs outside Compose.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# The runtime role of the server, which cannot change the schema, and the
# migration role, which owns it and is used only by "admin migrate" (the
# migrate service of Compose). See docs/configuration.md#database-roles.
POSTGRES_USER=exchange_app
POSTGRES_PASSWORD=exchange_app
POSTGRES_MIGRATIONS_USER=exchange_owner
POSTGRES_MIGRATIONS_PASSWORD=exchange_owner
POSTGRES_DB=exchange
POSTGRES_SSLMODE=disable
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=5
POSTGRES_CONN_MAX_LIFETIME_MINUTES=5
POSTGRES_CONN_MAX_IDLE_TIME_MINUTES=5

# Redis
# standalone, sentinel, or cluster; see docs/redis-high-availability.md
# REDIS_MODE=standalone
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_USERNAME=
REDIS_PASSWORD=redis
# REDIS_SENTINEL_MASTER_NAME=
# REDIS_SENTINEL_ADDRESSES=sentinel-1:26379,sentinel-2:26379,sentinel-3:26379
# REDIS_CLUSTER_ADDRESSES=
# REDIS_DURABLE_WRITES_REPLICAS=0
# REDIS_DURABLE_WRITES_TIMEOUT_MS=250
# REDIS_ASSUME_NOEVICTION=false
# REDIS_TLS_ENABLED=false
# REDIS_TLS_CA_FILE=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=2
REDIS_DIAL_TIMEOUT_MS=1000
REDIS_READ_TIMEOUT_MS=1000
REDIS_WRITE_TIMEOUT_MS=1000
REDIS_POOL_TIMEOUT_MS=2000
REDIS_MAX_RETRIES=1

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
# The nodes of a cluster, in place of RABBITMQ_HOST and RABBITMQ_PORT
# RABBITMQ_HOSTS=rmq-1:5672,rmq-2:5672,rmq-3:5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# RABBITMQ_VHOST=/
# RABBITMQ_TLS_ENABLED=false
# RABBITMQ_TLS_CA_FILE=

# JWT signing keys, generated as described in the README. Compose mounts the
# user keys as secrets and sets these paths itself.
JWT_SSL_USER_PRIVATE_KEY=internal/ssl/user/private_key.pem
JWT_SSL_USER_PUBLIC_KEY=internal/ssl/user/public_key.pem
# Optional: admin sign-in needs its own key pair.
# JWT_SSL_ADMIN_PRIVATE_KEY=internal/ssl/admin/private_key.pem
# JWT_SSL_ADMIN_PUBLIC_KEY=internal/ssl/admin/public_key.pem
JWT_ISSUER=crypto-exchange
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_MINUTES=10080
# The absolute lifetime of a session, at least the refresh token lifetime (#144).
JWT_SESSIONS_MAX_LIFETIME_MINUTES=43200

# Sign-in codes
OTP_AUTH_NAME=AUTH
OTP_AUTH_TTL_SECONDS=60
OTP_AUTH_LENGTH=6
OTP_AUTH_RETRY_LIMIT=3

# Data-protection keys (docs/data-protection.md): transit, local
# (development only, refused in release mode), or empty to load none.
# They protect the sign-in codes, the authenticator secrets of
# administrators, and the row seals, so release mode requires them. Empty,
# in development: sign-in codes use a random secret per process, and admin
# sign-in is disabled.
# local needs KEYS_LOCAL_KEK (openssl rand -base64 32); transit needs
# VAULT_ADDR, VAULT_TOKEN, and KEYS_TRANSIT_KEY.
KEYS_PROVIDER=
KEYS_LOCAL_KEK=
VAULT_ADDR=
VAULT_TOKEN=
KEYS_TRANSIT_KEY=

# Delivery of sign-in codes; the providers are configured in the
# notifications section of the configuration file.
SMTP_PASSWORD=
KAVENEGAR_API_KEY=

# WebSocket
WS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
WS_PING_INTERVAL_SECONDS=30
WS_MAX_MESSAGE_SIZE_BYTES=1048576

# Rate limits
RATE_LIMITS_TIMEOUT_MS=250
RATE_LIMITS_REST_REQUESTS_PER_SECOND=100
RATE_LIMITS_REST_BURST=200
RATE_LIMITS_WS_MESSAGES_PER_SECOND=50
RATE_LIMITS_WS_BURST=100
RATE_LIMITS_TRADING_ORDERS_PER_SECOND=10
RATE_LIMITS_TRADING_BURST=20
RATE_LIMITS_AUTH_LOGIN_ATTEMPTS_PER_MINUTE=5
RATE_LIMITS_AUTH_OTP_REQUESTS_PER_HOUR=10

# TLS (optional)
SERVER_TLS_ENABLED=false
SERVER_TLS_CERT_FILE=config/ssl/cert.pem
SERVER_TLS_KEY_FILE=config/ssl/key.pem
